# Auth
JWT_SECRET=dev-secret-change-in-prod

# Ollama
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://ollama:11434

# DynamoDB Local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1
